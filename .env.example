# Public Cloudflare Turnstile widget key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Private Cloudflare Turnstile verification key
TURNSTILE_SECRET_KEY=

# Optional strict hostname check, for example nextdesign.dev
TURNSTILE_EXPECTED_HOSTNAME=

# Private Resend sending-only API key
RESEND_API_KEY=

# Must use a domain verified in Resend, for example Next Design <inquiries@nextdesign.dev>
CONTACT_FROM_EMAIL=

# Inbox that receives website inquiries
CONTACT_TO_EMAIL=
